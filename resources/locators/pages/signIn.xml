<page xmlns="http://www.testlum.com/testing/model/pages" 
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.testlum.com/testing/model/pages pages.xsd">

  <details>
    <name>Generated by Testlum</name>
    <url>https://testlum.com/sign-in</url>
    <description>Locator file generated by Testlum for page https://testlum.com/sign-in</description>
  </details>

  <locators>

    <locator locatorId="loginP">
      <xpath>(//div[@id='app']/div/div[2]/p)[1]</xpath>
      <xpath>//p[normalize-space(.)='Login']</xpath>
    </locator>

    <locator locatorId="enterYourEmailInput">
      <className>email</className>
      <id>emailInput</id>
      <xpath>(//input[@id='emailInput'])[1]</xpath>
      <xpath>(//div[@id='app']/div/div[2]/div/div/input)[1]</xpath>
    </locator>

    <locator locatorId="loginText">
      <xpath>//span[normalize-space(.)='Login']</xpath>
      <xpath>(//div[@id='app']/div/header/div/div[2]/span)[1]</xpath>
    </locator>

    <locator locatorId="logInButton">
      <id>login-button</id>
      <xpath>(//div[@id='app']/div/div[2]/div/button)[1]</xpath>
      <xpath>//button[normalize-space(.)='Log in']</xpath>
      <xpath>(//button[@id='login-button'])[1]</xpath>
    </locator>

    <locator locatorId="enterPasswordInput">
      <className>password</className>
      <xpath>(//div[@id='app']/div/div[2]/div/div[3]/div[2]/div/input)[1]</xpath>
      <xpath>(//input[@name='password'])[1]</xpath>
    </locator>

    <locator locatorId="validationTextContainer">
      <xpath>(//div[@id='app']/div/div[2]/div/div[3]/div[3])[1]</xpath>
      <xpath>//div[normalize-space(.)="Password should have at least 1 lowercase letter, 1 uppercase letter and a number, it's length should be at least 8 characters"]</xpath>
    </locator>

  </locators>

</page>

